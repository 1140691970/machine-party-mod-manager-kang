; Standalone Godot 4.5.2 preview project for Bubble Blitz (macOS local testing).
; Excluded from R2 package ZIP by scripts/pack-mod.mjs.

config_version=5

[application]

config/name="Bubble Blitz"
run/main_scene="res://bubble_blitz_scene.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
