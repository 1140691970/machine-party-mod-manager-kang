; Engine configuration file.
; Standalone launch config for running Roller Carnival directly on macOS Godot 4.5.2.

config_version=5

[application]

config/name="Roller Carnival (滾筒嘉年華)"
run/main_scene="res://roller_carnival_scene.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[rendering]

lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
